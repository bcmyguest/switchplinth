{
  "name": "product-site",
  "version": "0.0.0",
  "description": "Marketing and docs site (static; Astro + Starlight).",
  "scripts": {
    "theme": "node scripts/gen-theme.mjs",
    "dev": "node scripts/gen-theme.mjs && astro dev",
    "build": "node scripts/gen-theme.mjs && astro build && node scripts/check-privacy.mjs dist",
    "check:privacy": "node scripts/check-privacy.mjs dist",
    "preview": "astro preview",
    "screenshots": "node scripts/screenshots.mjs",
    "hero-loop": "node scripts/hero-loop.mjs",
    "app-screenshots": "node scripts/app-screenshots.mjs",
    "workflow-gif": "node scripts/workflow-gif.mjs",
    "export-architecture": "node scripts/export-architecture.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "satori": "^0.57.2",
    "yaml": "^2.9.1"
  },
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  }
}
