---
// Hero demo: the food-delivery sample's event-transport decision, drawn as a
// blueprint-style sheet. Switching Kafka <-> SQS redraws the order-event route.
// Plain SVG + CSS with a ~1 KB script; no framework runtime on the landing page.
import { site } from '../../site.config';
import MapNode from './MapNode.astro';

type Dir = 'right' | 'down' | 'up';
const tip = (x: number, y: number, dir: Dir) =>
  ({
    right: `${x},${y} ${x - 9},${y - 5} ${x - 9},${y + 5}`,
    down: `${x},${y} ${x - 5},${y - 9} ${x + 5},${y - 9}`,
    up: `${x},${y} ${x - 5},${y + 9} ${x + 5},${y + 9}`,
  })[dir];

type Edge = { route: 'kafka' | 'sqs' | 'static'; d: string; tip: string };

// Desktop sheet: 720 x 400, three columns.
const wide: Edge[] = [
  { route: 'kafka', d: 'M204 120 H259', tip: tip(268, 120, 'right') },
  { route: 'kafka', d: 'M452 120 H476 Q484 120 484 128 V184 Q484 192 492 192 H507', tip: tip(516, 192, 'right') },
  { route: 'sqs', d: 'M204 134 H228 Q236 134 236 142 V264 Q236 272 244 272 H259', tip: tip(268, 272, 'right') },
  { route: 'sqs', d: 'M452 280 H476 Q484 280 484 272 V216 Q484 208 492 208 H507', tip: tip(516, 208, 'right') },
  { route: 'static', d: 'M204 296 H259', tip: tip(268, 296, 'right') },
];

// Phone sheet: 360 x 512, stacked rows.
const tall: Edge[] = [
  { route: 'kafka', d: 'M150 104 V128 Q150 136 142 136 H102 Q94 136 94 144 V167', tip: tip(94, 176, 'down') },
  { route: 'kafka', d: 'M94 232 V300 Q94 308 102 308 H142 Q150 308 150 316 V331', tip: tip(150, 340, 'down') },
  { route: 'sqs', d: 'M210 104 V128 Q210 136 218 136 H258 Q266 136 266 144 V167', tip: tip(266, 176, 'down') },
  { route: 'sqs', d: 'M266 232 V300 Q266 308 258 308 H218 Q210 308 210 316 V331', tip: tip(210, 340, 'down') },
  { route: 'static', d: 'M320 440 V241', tip: tip(320, 232, 'up') },
];
const cls = (e: Edge) => (e.route === 'static' ? 'static' : `via-${e.route}`);
const routed = (edges: Edge[]) => edges.filter((e) => e.route !== 'static');
const sheet = site.name.toUpperCase();
---
<figure class="hero-map not-prose" data-option="kafka" aria-labelledby="hero-map-caption">
  <div class="grid gap-3">
    <div class="map-surface relative overflow-hidden rounded-xl border border-line">
      <span class="scenario-pill absolute left-3 top-3 z-10 rounded-full px-2.5 py-0.5 text-xs font-semibold" aria-hidden="true">
        <span class="when-kafka">Repository selection</span><span class="when-sqs">What-if preview</span>
      </span>
      <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
        <defs>
          <pattern id="grid-minor" width="12" height="12" patternUnits="userSpaceOnUse">
            <path d="M12 0H0V12" class="grid-minor" />
          </pattern>
          <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <rect width="60" height="60" fill="url(#grid-minor)" />
            <path d="M60 0H0V60" class="grid-major" />
          </pattern>
        </defs>
      </svg>

      <svg viewBox="0 0 720 400" role="img" aria-labelledby="hero-svg-title hero-svg-desc" class="hidden h-auto w-full sm:block">
        <title id="hero-svg-title">Architecture map for the event-transport decision</title>
        <desc id="hero-svg-desc">Order Service publishes order events to Fulfillment Service through Apache Kafka or, in the alternative, through Amazon SQS. Payments Service uses its own SQS retry queue in both cases.</desc>
        <rect width="720" height="400" fill="url(#grid)" />
        <rect class="group" x="12" y="44" width="200" height="312" rx="14" /><text class="group-label" x="26" y="64">ORDERING</text>
        <rect class="group" x="260" y="44" width="200" height="312" rx="14" /><text class="group-label" x="274" y="64">MESSAGING</text>
        <rect class="group" x="508" y="44" width="200" height="312" rx="14" /><text class="group-label" x="522" y="64">FULFILLMENT</text>
        {routed(wide).map((e) => <path class={`ghost ${cls(e)}`} d={e.d} />)}
        {wide.map((e) => <path class={`base ${cls(e)}`} d={e.d} pathLength={e.route === 'static' ? undefined : 1} />)}
        {routed(wide).map((e) => <path class={`flow ${cls(e)}`} d={e.d} />)}
        {wide.map((e) => <polygon class={`tip ${cls(e)}`} points={e.tip} />)}
        <text class="edge-label via-kafka" x="494" y="158">ORDER EVENTS</text>
        <text class="edge-label via-sqs" x="494" y="250">ORDER EVENTS</text>
        <text class="edge-label" x="212" y="324">PAYMENT RETRIES</text>
        <MapNode x={20} y={92} w={184} name="Order Service" kind="service" />
        <MapNode x={20} y={268} w={184} name="Payments Service" kind="service" />
        <MapNode x={268} y={92} w={184} name="Apache Kafka" kind="stream" class="kafka" />
        <MapNode x={268} y={252} w={184} name="Amazon SQS" kind="queue" />
        <MapNode x={516} y={172} w={184} name="Fulfillment Service" kind="service" />
        <g class="title-block" transform="translate(508 366)">
          <rect width="200" height="26" rx="4" />
          <path d="M92 0V26M148 0V26" />
          <text x="8" y="17">{sheet}</text>
          <text x="100" y="17">A-101</text>
          <text x="156" y="17">EVENTS</text>
        </g>
      </svg>

      <svg viewBox="0 0 360 512" role="img" aria-labelledby="hero-svg-title-m hero-svg-desc" class="block h-auto w-full sm:hidden">
        <title id="hero-svg-title-m">Architecture map for the event-transport decision</title>
        <rect width="360" height="512" fill="url(#grid)" />
        <rect class="group" x="8" y="150" width="344" height="104" rx="14" /><text class="group-label" x="344" y="166" text-anchor="end">MESSAGING</text>
        {routed(tall).map((e) => <path class={`ghost ${cls(e)}`} d={e.d} />)}
        {tall.map((e) => <path class={`base ${cls(e)}`} d={e.d} pathLength={e.route === 'static' ? undefined : 1} />)}
        {routed(tall).map((e) => <path class={`flow ${cls(e)}`} d={e.d} />)}
        {tall.map((e) => <polygon class={`tip ${cls(e)}`} points={e.tip} />)}
        <text class="edge-label via-kafka" x="16" y="128">ORDER EVENTS</text>
        <text class="edge-label via-sqs" x="344" y="128" text-anchor="end">ORDER EVENTS</text>
        <text class="edge-label" x="336" y="336" text-anchor="middle" transform="rotate(-90 336 336)">PAYMENT RETRIES</text>
        <MapNode x={88} y={48} w={184} name="Order Service" kind="service" />
        <MapNode x={16} y={176} w={156} name="Apache Kafka" kind="stream" class="kafka" />
        <MapNode x={188} y={176} w={156} name="Amazon SQS" kind="queue" />
        <MapNode x={58} y={340} w={184} name="Fulfillment Service" kind="service" />
        <MapNode x={160} y={440} w={184} name="Payments Service" kind="service" />
      </svg>

      <ul class="legend flex flex-wrap gap-x-4 gap-y-1.5 border-t border-line bg-panel px-3 py-2 text-xs text-muted" aria-label="Legend">
        <li class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="lg-icon" aria-hidden="true"><rect x="2" y="3" width="20" height="7" rx="2" /><rect x="2" y="14" width="20" height="7" rx="2" /></svg>Service</li>
        <li class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="lg-icon lg-msg" aria-hidden="true"><path d="M3 7h13M3 12h17M3 17h13M17 9l3 3-3 3" /></svg>Event stream</li>
        <li class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="lg-icon lg-msg" aria-hidden="true"><rect x="2" y="7" width="20" height="10" rx="2" /><path d="M8 7v10M14 7v10" /></svg>Queue</li>
        <li class="flex items-center gap-1.5"><svg viewBox="0 0 28 10" class="lg-line" aria-hidden="true"><path class="lg-active" d="M1 5H27" /><path class="lg-dots" d="M1 5H27" /></svg>Active route</li>
        <li class="flex items-center gap-1.5"><svg viewBox="0 0 28 10" class="lg-line" aria-hidden="true"><path class="lg-ghost" d="M1 5H27" /></svg>Alternative route</li>
        <li class="flex items-center gap-1.5"><svg viewBox="0 0 28 10" class="lg-line" aria-hidden="true"><path class="lg-static" d="M1 5H27" /></svg>Unchanged</li>
      </ul>
    </div>

    <div class="grid gap-3 rounded-xl border border-line bg-panel p-4 text-sm sm:grid-cols-[17rem_minmax(0,1fr)] sm:gap-5">
      <div class="flex flex-col gap-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-muted">Decision</p>
        <p class="font-semibold leading-snug">Event delivery for food orders</p>
        <div class="flex gap-2" role="group" aria-label="Event transport option">
          <button type="button" class="opt" data-pick="kafka" aria-pressed="true">Apache Kafka</button>
          <button type="button" class="opt" data-pick="sqs" aria-pressed="false">Amazon SQS</button>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <blockquote class="when-kafka quote">
          “We chose Apache Kafka because replay and per-order ordering matter more than reducing broker operations.”
        </blockquote>
        <blockquote class="when-sqs quote">
          “Amazon SQS would reduce infrastructure work. … but replaying a selected range of historical order events would require additional application support.”
        </blockquote>
        <p class="text-xs text-muted">
          <span class="when-kafka">Selected option ·</span><span class="when-sqs">Alternative ·</span>
          <code><span class="whitespace-nowrap">docs/decisions/</span><wbr /><span class="whitespace-nowrap">event-transport.md</span></code>
        </p>
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
    </div>
  </div>
  <figcaption id="hero-map-caption" class="mt-3 text-xs text-muted">
    Simplified from the bundled food-delivery sample (deterministic mock extraction). Quotes are the sample's source text.
  </figcaption>
</figure>

<style is:global>
  .hero-map { --mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; }
  .hero-map .map-surface { background: var(--c-map-canvas); }
  .hero-map .grid-minor { fill: none; stroke: var(--c-map-dot); stroke-width: 0.5; opacity: 0.45; }
  .hero-map .grid-major { fill: none; stroke: var(--c-map-dot); stroke-width: 1; }

  .hero-map .group { fill: var(--c-brand-soft); fill-opacity: 0.4; stroke: var(--c-line); stroke-width: 1; stroke-dasharray: 6 4; }
  .hero-map .group-label,
  .hero-map .edge-label,
  .hero-map .node-kind,
  .hero-map .title-block text { font-family: var(--mono); letter-spacing: 0.08em; }
  .hero-map .group-label { fill: var(--c-muted); font-size: 10px; font-weight: 600; }

  .hero-map .card { fill: var(--c-panel); stroke: var(--c-line); stroke-width: 1.25; filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.14)); }
  .hero-map .icon-bg { fill: var(--c-brand-soft); }
  .hero-map .icon { fill: none; stroke: var(--c-source); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .hero-map .node-stream .icon-bg, .hero-map .node-queue .icon-bg { fill: var(--c-inferred-soft); }
  .hero-map .node-stream .icon, .hero-map .node-queue .icon { stroke: var(--c-warning); }
  .hero-map .node-name { fill: var(--c-ink); font: 600 14px 'DM Sans', system-ui, sans-serif; }
  .hero-map .node-kind { fill: var(--c-muted); font-size: 10px; }
  .hero-map .node { transition: opacity 0.5s; }

  .hero-map .edge-label { font-size: 10px; font-weight: 600; fill: var(--c-muted); paint-order: stroke; stroke: var(--c-map-canvas); stroke-width: 4px; stroke-linejoin: round; transition: opacity 0.4s; }

  /* Routes: a faint dashed ghost for the alternative, a solid line that draws in for the active route, and moving dots on top. */
  .hero-map .ghost { fill: none; stroke: var(--c-muted); stroke-width: 1.5; stroke-dasharray: 4 5; opacity: 0.5; transition: opacity 0.4s; }
  .hero-map .base { fill: none; stroke: var(--c-brand); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .hero-map .base.via-kafka, .hero-map .base.via-sqs { stroke-dasharray: 1 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.7s ease-in-out; }
  .hero-map .base.static { stroke: var(--c-muted); stroke-width: 1.75; }
  .hero-map .flow { fill: none; stroke: var(--c-source); stroke-width: 4.5; stroke-linecap: round; stroke-dasharray: 0 16; opacity: 0; transition: opacity 0.3s; }
  .hero-map .tip { fill: var(--c-brand); opacity: 0; transition: opacity 0.2s; }
  .hero-map .tip.static { fill: var(--c-muted); opacity: 1; }

  .hero-map[data-option='kafka'] .base.via-kafka,
  .hero-map[data-option='sqs'] .base.via-sqs { stroke-dashoffset: 0; }
  .hero-map[data-option='kafka'] .flow.via-kafka,
  .hero-map[data-option='sqs'] .flow.via-sqs { opacity: 1; animation: hero-flow 1.1s linear infinite; transition-delay: 0.5s; }
  .hero-map[data-option='kafka'] .tip.via-kafka,
  .hero-map[data-option='sqs'] .tip.via-sqs { opacity: 1; transition-delay: 0.55s; }
  .hero-map[data-option='kafka'] .ghost.via-kafka,
  .hero-map[data-option='sqs'] .ghost.via-sqs { opacity: 0; }
  /* Labels of the inactive route are hidden outright, not merely faded. */
  .hero-map[data-option='kafka'] .edge-label.via-sqs,
  .hero-map[data-option='sqs'] .edge-label.via-kafka { opacity: 0; }
  .hero-map[data-option='sqs'] .node.kafka { opacity: 0.45; }
  .hero-map[data-option='sqs'] .node.kafka .card { stroke-dasharray: 5 4; }
  @keyframes hero-flow { to { stroke-dashoffset: -16; } }

  .hero-map .title-block rect { fill: var(--c-panel); stroke: var(--c-line); }
  .hero-map .title-block path { stroke: var(--c-line); }
  .hero-map .title-block text { fill: var(--c-muted); font-size: 9px; font-weight: 600; }

  .hero-map .lg-icon { width: 14px; height: 14px; fill: none; stroke: var(--c-source); stroke-width: 2; stroke-linecap: round; }
  .hero-map .lg-icon.lg-msg { stroke: var(--c-warning); }
  .hero-map .lg-line { width: 28px; height: 10px; }
  .hero-map .lg-line path { fill: none; }
  .hero-map .lg-active { stroke: var(--c-brand); stroke-width: 2.5; }
  .hero-map .lg-dots { stroke: var(--c-source); stroke-width: 4.5; stroke-linecap: round; stroke-dasharray: 0 9; }
  .hero-map .lg-ghost { stroke: var(--c-muted); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .hero-map .lg-static { stroke: var(--c-muted); stroke-width: 1.75; }

  .hero-map .when-sqs { display: none; }
  .hero-map[data-option='sqs'] .when-sqs { display: initial; }
  .hero-map[data-option='sqs'] .when-kafka { display: none; }
  .hero-map blockquote.quote { border-left: 3px solid var(--c-brand); padding-left: 0.75rem; color: var(--c-ink); line-height: 1.5; }
  .hero-map[data-option='sqs'] blockquote.when-sqs,
  .hero-map[data-option='kafka'] blockquote.when-kafka { display: block; }

  .hero-map .scenario-pill { background: var(--c-panel); border: 1px solid var(--c-line); color: var(--c-source); }
  .hero-map[data-option='sqs'] .scenario-pill { color: var(--c-warning); border-color: var(--c-warning); }

  .hero-map .opt { flex: 1; border: 1px solid var(--c-line); border-radius: 0.5rem; padding: 0.45rem 0.5rem; font-weight: 600; font-size: 0.8125rem; background: var(--c-panel-raised); color: var(--c-ink); cursor: pointer; white-space: nowrap; transition: background 0.2s; }
  .hero-map .opt:hover { background: var(--c-hover); }
  .hero-map .opt[aria-pressed='true'] { background: var(--c-decision); border-color: var(--c-decision); color: var(--c-on-decision); }
  .hero-map .opt[aria-pressed='true']::before { content: '✓ '; }
  .hero-map .opt:focus-visible { outline: 2px solid var(--c-brand); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .hero-map *,
    .hero-map .base.via-kafka,
    .hero-map .base.via-sqs { transition: none !important; animation: none !important; }
    .hero-map .flow { stroke-dasharray: none; stroke-width: 0; }
  }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('.hero-map');
  if (fig) {
    const buttons = fig.querySelectorAll<HTMLButtonElement>('[data-pick]');
    const live = fig.querySelector<HTMLElement>('[data-live]');
    const set = (option: string) => {
      fig.dataset.option = option;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === option)));
    };
    let timer: number | undefined;
    const stop = () => window.clearInterval(timer);
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        stop();
        set(b.dataset.pick!);
        if (live) live.textContent = b.dataset.pick === 'sqs'
          ? 'What-if preview: order events route through Amazon SQS.'
          : 'Repository selection: order events route through Apache Kafka.';
      }),
    );
    // Auto-demo only when motion is welcome, and only while the hero is visible.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const start = () => {
        stop();
        timer = window.setInterval(() => set(fig.dataset.option === 'kafka' ? 'sqs' : 'kafka'), 4200);
      };
      let interacted = false;
      fig.addEventListener('pointerdown', () => (interacted = true), { once: true });
      fig.addEventListener('focusin', () => { interacted = true; stop(); }, { once: true });
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting && !interacted) start();
        else stop();
      }).observe(fig);
    }
  }
</script>
